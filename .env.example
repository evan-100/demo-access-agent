# Okta Integrator Free Plan org (https://developer.okta.com/signup/)
OKTA_ORG_URL=https://integrator-1234567.okta.com
# Admin Console -> Security -> API -> Tokens
OKTA_API_TOKEN=

# Anthropic (or run `ant auth login` and leave blank)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# OIDC app (Task 10). Created in Admin Console -> Applications
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
# openssl rand -hex 32
APP_SESSION_SECRET=

# Seed users (scripts/seed.mjs). Must satisfy Okta's default password policy.
SEED_USER_PASSWORD=

# Agent tuning
LEDGER_PATH=data/grants.jsonl
SWEEP_INTERVAL_MS=15000
AUTHZ_CACHE_MS=5000
MAX_DURATION_MINUTES=1440
